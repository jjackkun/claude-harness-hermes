# R-dep 의존 계약 — tier 번호가 큰 쪽이 상위다. 하위는 상위를 import 할 수 없다.
# 같은 tier 안의 상호 참조는 허용한다.
# tier 는 손으로 적은 것이 아니라 2026-08-24 실측 그래프에서 위상적으로 계산했다.
# 스펙: docs/superpowers/specs/2026-08-24-module-dependency-contract-design.md

# 계약이 관할하는 범위. 밖의 파일(assets/skills/ 의 외부 도입 스크립트 등)은
# 미등록 경고(R-dep-4) 대상이 아니다.
scope: scripts/*.py lib/*.py assets/hooks/*.py

tier: 0  assets/hooks/complexity.py assets/hooks/depcheck.py assets/hooks/plan_state.py assets/hooks/coverage_probe.py assets/hooks/iface_width.py assets/hooks/gate_event.py assets/hooks/gate_report.py assets/hooks/doc_counts.py assets/hooks/design_cover.py scripts/mutation-probe.py lib/generate_codex_hooks.py
tier: 0  lib/generate_settings.py lib/generate_settings_json.py
# 스킬 수익률(계획 2026-09-18-skill-yield-junk): yield 는 표준 모듈만(0), cleanup 이 import 하므로 cleanup 은 1.
tier: 0  scripts/hermes_skill_yield.py
tier: 1  scripts/hermes-cleanup.py
tier: 0  scripts/hermes-correlate.py scripts/hermes-evolve-skill.py
tier: 0  scripts/hermes-increment.py scripts/hermes-manager.py scripts/hermes-message.py
tier: 0  scripts/hermes-prune.py scripts/hermes-reindex.py scripts/hermes_lifecycle_apply.py
tier: 0  scripts/hermes_reuse.py scripts/hermes_secret_values.py scripts/hermes_skills.py
tier: 0  scripts/hermes_skill_render.py
tier: 0  scripts/hermes_keywords.py scripts/hermes_history_fragments.py
# 작업 이력(계획 2026-09-15-universe-id-journal). tier 는 실측 import 그래프에서 계산했다:
# uuid7·universe·journal_schema·journal_views 는 의존 없음, journal 은 그 셋을 쓰고,
# CLI 는 journal 을 쓰며, loop_decisions 는 hermes_loop(2) 와 journal(1) 을 쓴다.
tier: 0  scripts/hermes_uuid7.py scripts/hermes_universe.py
tier: 0  scripts/hermes_journal_schema.py scripts/hermes_journal_views.py scripts/hermes_journal_migrate.py
# 암호 계층(계획 2026-09-15-sync-transport-encryption Step 2): crypto·mnemonic 은 표준 모듈만,
# keys 는 crypto 를 쓴다.
tier: 0  scripts/hermes_crypto.py scripts/hermes_mnemonic.py
tier: 0  scripts/hermes_known_values.py   # 마스킹 자동 정답지(T-20 ③): 표준 모듈만. redact 가 부른다
tier: 1  scripts/hermes_keys.py
# 운반 계층: sync_ref 는 git 만, sync_fragments 는 crypto(0)·history_fragments(0)·keys(1)·
# journal_schema(0) 을 쓰고, hermes-sync.py 는 그 둘과 universe 를 쓴다.
tier: 0  scripts/hermes_sync_ref.py
tier: 2  scripts/hermes_sync_fragments.py scripts/hermes_sync_learning.py   # learning(요약·패턴 조각, T-17)은 crypto(0)·keys(1)만 쓰고 fragments 가 부른다(같은 tier)
tier: 3  scripts/hermes-sync.py
# 명부·조직(계획 2026-09-15-agent-identity): yaml_subset 은 표준 모듈만, org 는 uuid7·yaml_subset,
# roster 는 org·uuid7, CLI 는 roster·org.
tier: 0  scripts/hermes_yaml_subset.py
tier: 1  scripts/hermes_org.py
tier: 2  scripts/hermes_roster.py
tier: 3  scripts/hermes_review.py scripts/hermes-agent.py
tier: 0  scripts/hermes_summons.py
tier: 3  scripts/hermes-summon.py
# 기억 이벤트(계획 2026-09-15-agent-identity 목표 8·9): events 는 표준 모듈만,
# conflicts 는 표준만, view 는 conflicts. sync_fragments 가 events 를 import 한다.
tier: 0  scripts/hermes_memory_events.py scripts/hermes_memory_conflicts.py
# 결정화 철회 보류(계획 2026-09-18-crystallize-reversed-guard): 표준 모듈만, crystallize(1) 가 import.
tier: 0  scripts/hermes_reversed_guard.py
tier: 1  scripts/hermes_memory_view.py scripts/hermes_memory_select.py
# 인계 봉투(계획 2026-09-15-agent-identity 목표 10·11·12): done_when 은 표준 모듈만,
# handoff 는 done_when·journal·journal_views·uuid7 을 import 한다(최상위 tier 1 → handoff tier 2).
tier: 0  scripts/hermes_done_when.py
tier: 2  scripts/hermes_review_chain.py scripts/hermes_handoff.py scripts/hermes_handoff_kind.py scripts/hermes_handoff_queue.py scripts/hermes_owner_memory.py scripts/hermes_agent_export.py
# 제안 봉투(계획 5): envelope=uuid7(0)→1, gate=mesh_gate(2)→3, propose=gate(3)→4.
tier: 1  scripts/hermes_envelope.py
tier: 3  scripts/hermes_envelope_gate.py
tier: 4  scripts/hermes-propose.py
# 스킬 4층(계획 5): layers 는 uuid7(tier0)만 import → tier1. 색인기는 layers 를 import → tier2.
tier: 1  scripts/hermes_skill_layers.py
tier: 0  scripts/hermes_crystallize_evidence.py   # 결정화 증거 수집(표준 모듈만) — crystallize(1) 가 부른다
tier: 1  assets/hooks/check-secrets.py scripts/hermes-crystallize.py
tier: 2  scripts/hermes-index-skills.py scripts/hermes_skill_extends.py
tier: 1  scripts/hermes_redact.py scripts/hermes_search_fallback.py
# search 는 layers(1)+render(0)+지연 roster(2)/org(1) → tier3. skill CLI 는 layers(1) → tier2.
tier: 3  scripts/hermes-search.py
tier: 2  scripts/hermes-skill.py
tier: 1  scripts/hermes_dream_evolve.py scripts/hermes_journal.py
tier: 2  scripts/hermes-export-history.py scripts/hermes-lifecycle.py scripts/hermes-recall.py
tier: 2  scripts/hermes-scrub-history.py scripts/hermes-summarize.py scripts/hermes_loop.py
tier: 2  scripts/hermes_mesh_gate.py scripts/hermes_save_session_storage.py
tier: 2  scripts/hermes-dream.py scripts/hermes-journal.py
tier: 3  scripts/hermes-init.py scripts/hermes_loop_prompt.py scripts/hermes_loop_report.py
tier: 3  scripts/hermes_save_session_patterns.py scripts/hermes_save_session_signals.py
tier: 3  scripts/hermes_loop_decisions.py
tier: 4  scripts/hermes-loop.py scripts/hermes-save-session.py

# 디렉터리 경계 — 훅은 자립해야 한다.
# 설치본에서 scripts/ 가 함께 있다는 보장이 없다.
forbid: assets/hooks/*.py -> scripts/*.py

# 위 forbid 의 예외. try/except ImportError 로 감싸 없어도 동작하는 것만 등록한다.
# 등록만으로 면제되지 않는다 — 실제로 선택적인지 검사기가 확인한다.
# check-secrets.py 는 정답지 모듈이 없으면 형태 규칙만으로 동작한다(차단기가 죽는 것보다 낫다).
optional: assets/hooks/check-secrets.py -> hermes_secret_values
# 커밋 게이트 훅(표준 모듈만, 다른 scripts 를 import 하지 않는다) — 2026-09-20 자기 계약 검사가 미등록으로 잡음
tier: 0  scripts/hooks/complexity.py scripts/hooks/coverage_probe.py scripts/hooks/depcheck.py scripts/hooks/design_cover.py scripts/hooks/doc_counts.py scripts/hooks/gate_event.py scripts/hooks/gate_report.py
# 대시보드(계획 2026-09-18-hermes-dashboard): html 은 표준 모듈만, data 는 handoff_queue·owner_memory(2)·skill_layers(1)·skill_yield(0)·hooks/gate_report(0) 를 쓴다
tier: 0  scripts/hermes_dashboard_html.py
tier: 3  scripts/hermes_dashboard_data.py
tier: 4  scripts/hermes-dashboard.py
