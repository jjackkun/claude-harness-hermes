{
  "_doc": "R-struct 언어×규칙 사례. rule = 규칙 번호(배럴은 '번호:strategy'), expect = block|warn|pass. bad 는 위반, good 은 bad 를 고친 판. common=true 면 언어 무관 규칙(R-struct-7)을 켠다. 실행: bash tests/structure-gate-test.sh",
  "cases": [
    { "lang": "vue", "rule": "1:sfc-folder", "expect": "block",
      "bad":  { "src/components/Button.vue": "<template><button/></template>" },
      "good": { "src/components/Button/Button.vue": "<template><button/></template>",
                "src/components/Button/index.js": "export { default } from './Button.vue'" } },
    { "lang": "vue", "rule": "2:sfc-folder", "expect": "block",
      "bad":  { "src/components/Card/Card.vue": "<template><div/></template>" },
      "good": { "src/components/Card/Card.vue": "<template><div/></template>",
                "src/components/Card/index.js": "export { default } from './Card.vue'" } },
    { "lang": "vue", "rule": "3", "expect": "block",
      "bad":  { "src/App.js": "import Btn from './components/Button/Button.vue'" },
      "good": { "src/App.js": "import Btn from './components/Button'" } },
    { "lang": "vue", "rule": "4", "expect": "block",
      "bad":  { "src/lib/index.js": "export * from './a.js'" },
      "good": { "src/lib/index.js": "export { a } from './a.js'" } },

    { "lang": "js", "rule": "5:feature-root", "expect": "block",
      "bad":  { "src/features/cart/api.ts": "export const x = 1" },
      "good": { "src/features/cart/api.ts": "export const x = 1",
                "src/features/cart/index.ts": "export { x } from './api'" } },
    { "lang": "js", "rule": "6", "expect": "warn",
      "bad":  { "src/pages/home.ts": "import { x } from '../features/cart/api'",
                "src/features/cart/index.ts": "export { x } from './api'" },
      "good": { "src/pages/home.ts": "import { x } from '../features/cart'",
                "src/features/cart/index.ts": "export { x } from './api'" } },
    { "lang": "js", "rule": "6", "expect": "warn", "name": "별칭 경로($lib)도 풀어서 본다",
      "bad":  { "src/routes/page.ts": "import { x } from '$lib/features/cart/api'",
                "src/lib/features/cart/index.ts": "export { x } from './api'" },
      "good": { "src/routes/page.ts": "import { x } from '$lib/features/cart'",
                "src/lib/features/cart/index.ts": "export { x } from './api'" } },
    { "lang": "js", "rule": "5:feature-root", "expect": "pass", "name": "NestJS·Angular 의 modules/ 는 기능 루트가 아니다",
      "good": { "src/modules/user/user.service.ts": "export class UserService {}" } },
    { "lang": "js", "rule": "6", "expect": "pass", "name": "외부 패키지 경로는 판정하지 않는다",
      "good": { "src/app.ts": "import x from 'some-lib/features/foo/bar'" } },
    { "lang": "js", "rule": "4", "expect": "block", "langs": "auto", "name": "auto 모드 — vue·js 가 겹치는 .ts 도 한 건만",
      "bad":  { "src/lib/index.ts": "export * from './x'" },
      "good": { "src/lib/index.ts": "export { x } from './x'" } },
    { "lang": "js", "rule": "4", "expect": "block",
      "bad":  { "src/lib/index.ts": "export * from './x'" },
      "good": { "src/lib/index.ts": "export { x } from './x'" } },

    { "lang": "svelte", "rule": "5:component-dir", "expect": "block",
      "bad":  { "src/lib/components/Card/Card.svelte": "<div/>" },
      "good": { "src/lib/components/Card/index.svelte": "<div/>" } },
    { "lang": "svelte", "rule": "5:component-dir", "expect": "pass", "name": "낱개 컴포넌트·하위 컴포넌트 폴더는 허용 (전역 CLAUDE.md §6)",
      "good": { "src/lib/components/Button.svelte": "<button/>",
                "src/lib/components/Card/index.svelte": "<div/>",
                "src/lib/components/Card/components/Body.svelte": "<p/>" } },
    { "lang": "svelte", "rule": "5:component-dir", "expect": "pass", "name": "여러 컴포넌트를 묶은 분류 폴더는 컴포넌트 폴더가 아니다 (kis-trading components/layout 실측)",
      "good": { "src/lib/components/layout/Header.svelte": "<header/>",
                "src/lib/components/layout/Footer.svelte": "<footer/>" } },
    { "lang": "svelte", "rule": "5:feature-root", "expect": "block",
      "bad":  { "src/lib/features/cart/Cart.svelte": "<div/>" },
      "good": { "src/lib/features/cart/Cart.svelte": "<div/>",
                "src/lib/features/cart/index.ts": "export { default as Cart } from './Cart.svelte'" } },
    { "lang": "svelte", "rule": "6", "expect": "warn",
      "bad":  { "src/routes/+page.svelte": "<script>import Body from '$lib/components/Card/components/Body.svelte'</script>" },
      "good": { "src/routes/+page.svelte": "<script>import Card from '$lib/components/Card/index.svelte'</script>" } },

    { "lang": "python", "rule": "5:feature-root", "expect": "block",
      "bad":  { "app/features/cart/service.py": "def checkout():\n    pass\n" },
      "good": { "app/features/cart/service.py": "def checkout():\n    pass\n",
                "app/features/cart/__init__.py": "from .service import checkout\n" } },
    { "lang": "python", "rule": "5:package-child", "expect": "warn",
      "bad":  { "app/__init__.py": "", "app/core/config.py": "X = 1\n" },
      "good": { "app/__init__.py": "", "app/core/config.py": "X = 1\n", "app/core/__init__.py": "" } },
    { "lang": "python", "rule": "6", "expect": "warn",
      "bad":  { "app/main.py": "from app.features.cart.service import checkout\n",
                "app/features/cart/__init__.py": "from .service import checkout\n" },
      "good": { "app/main.py": "from app.features.cart import checkout\n",
                "app/features/cart/__init__.py": "from .service import checkout\n" } },
    { "lang": "python", "rule": "6", "expect": "warn", "name": "_ 로 시작하는 비공개 모듈",
      "bad":  { "app/api.py": "from app.core._impl import build\n" },
      "good": { "app/api.py": "from app.core import build\n" } },
    { "lang": "python", "rule": "4", "expect": "warn", "name": "Django settings 의 from .base import * 관용 때문에 경고",
      "bad":  { "app/pkg/__init__.py": "from .mod import *\n" },
      "good": { "app/pkg/__init__.py": "from .mod import a, b\n" } },

    { "lang": "java", "rule": "6", "expect": "warn",
      "bad":  { "src/main/java/com/shop/order/OrderService.java": "package com.shop.order;\nimport com.shop.cart.internal.CartStore;\n" },
      "good": { "src/main/java/com/shop/order/OrderService.java": "package com.shop.order;\nimport com.shop.cart.Cart;\n" } },
    { "lang": "java", "rule": "4", "expect": "warn",
      "bad":  { "src/main/java/com/shop/order/Order.java": "package com.shop.order;\nimport java.util.*;\n" },
      "good": { "src/main/java/com/shop/order/Order.java": "package com.shop.order;\nimport java.util.List;\n" } },

    { "lang": "dart", "rule": "5:feature-root", "expect": "block",
      "bad":  { "lib/features/cart/cart_view.dart": "class CartView {}\n" },
      "good": { "lib/features/cart/cart_view.dart": "class CartView {}\n",
                "lib/features/cart/cart.dart": "export 'cart_view.dart' show CartView;\n" } },
    { "lang": "dart", "rule": "6", "expect": "warn",
      "bad":  { "lib/features/checkout/pay.dart": "import 'package:shop/features/cart/src/store.dart';\n",
                "lib/features/checkout/checkout.dart": "export 'pay.dart' show pay;\n" },
      "good": { "lib/features/checkout/pay.dart": "import 'package:shop/features/cart/cart.dart';\n",
                "lib/features/checkout/checkout.dart": "export 'pay.dart' show pay;\n" } },
    { "lang": "dart", "rule": "4", "expect": "warn",
      "bad":  { "lib/shop.dart": "export 'src/a.dart';\n" },
      "good": { "lib/shop.dart": "export 'src/a.dart' show A;\n" } },

    { "lang": "go", "rule": "7:files", "expect": "warn", "common": true, "name": "go 는 언어 무관 규칙만 (패키지가 배럴, internal/ 은 컴파일러가 막음)",
      "bad":  { "pkg/store/a.go": "package store\n", "pkg/store/b.go": "package store\n", "pkg/store/c.go": "package store\n",
                "pkg/store/d.go": "package store\n", "pkg/store/e.go": "package store\n", "pkg/store/f.go": "package store\n" },
      "good": { "pkg/store/a.go": "package store\n", "pkg/store/b.go": "package store\n", "pkg/store/c.go": "package store\n",
                "pkg/store/d.go": "package store\n", "pkg/store/e.go": "package store\n" } },

    { "lang": "rust", "rule": "5:feature-root", "expect": "block",
      "bad":  { "src/features/cart/store.rs": "pub struct Store;\n" },
      "good": { "src/features/cart/store.rs": "pub struct Store;\n",
                "src/features/cart/mod.rs": "mod store;\npub use store::Store;\n" } },
    { "lang": "rust", "rule": "6", "expect": "warn",
      "bad":  { "src/order/mod.rs": "use crate::cart::internal::Store;\n" },
      "good": { "src/order/mod.rs": "use crate::cart::Store;\n" } },
    { "lang": "rust", "rule": "4", "expect": "block",
      "bad":  { "src/lib.rs": "pub use crate::cart::*;\n" },
      "good": { "src/lib.rs": "pub use crate::cart::Store;\n" } },

    { "lang": "kotlin", "rule": "6", "expect": "warn",
      "bad":  { "src/main/kotlin/shop/order/Order.kt": "package shop.order\nimport shop.cart.impl.CartRepo\n" },
      "good": { "src/main/kotlin/shop/order/Order.kt": "package shop.order\nimport shop.cart.CartRepo\n" } },
    { "lang": "kotlin", "rule": "4", "expect": "warn",
      "bad":  { "src/main/kotlin/shop/order/Order.kt": "package shop.order\nimport shop.cart.*\n" },
      "good": { "src/main/kotlin/shop/order/Order.kt": "package shop.order\nimport shop.cart.Cart\nimport java.util.*\n" } },

    { "lang": "csharp", "rule": "6", "expect": "warn",
      "bad":  { "src/Order/OrderService.cs": "using Shop.Cart.Internal;\nnamespace Shop.Order;\n" },
      "good": { "src/Order/OrderService.cs": "using Shop.Cart;\nnamespace Shop.Order;\n" } },

    { "lang": "php", "rule": "6", "expect": "warn",
      "bad":  { "src/Order/OrderService.php": "<?php\nuse App\\Cart\\Internal\\Store;\n" },
      "good": { "src/Order/OrderService.php": "<?php\nuse App\\Cart\\Store;\n" } },

    { "lang": "swift", "rule": "4", "expect": "block",
      "bad":  { "Sources/Shop/Exports.swift": "@_exported import Foundation\n" },
      "good": { "Sources/Shop/Exports.swift": "import Foundation\n" } },

    { "lang": "ruby", "rule": "5:feature-root", "expect": "block",
      "bad":  { "lib/cart/parser.rb": "class Parser; end\n" },
      "good": { "lib/cart/parser.rb": "class Parser; end\n", "lib/cart.rb": "require_relative 'cart/parser'\n" } },
    { "lang": "ruby", "rule": "6", "expect": "warn",
      "bad":  { "lib/order.rb": "require_relative 'cart/parser'\n", "lib/cart.rb": "require_relative 'cart/parser'\n" },
      "good": { "lib/order.rb": "require_relative 'cart'\n", "lib/cart.rb": "require_relative 'cart/parser'\n" } },

    { "lang": "python", "rule": "7:files", "expect": "warn", "common": true,
      "bad":  { "app/billing/a.py": "", "app/billing/b.py": "", "app/billing/c.py": "",
                "app/billing/d.py": "", "app/billing/e.py": "", "app/billing/f.py": "" },
      "good": { "app/billing/a.py": "", "app/billing/b.py": "", "app/billing/c.py": "",
                "app/billing/d.py": "", "app/billing/e.py": "" } },
    { "lang": "python", "rule": "7:name", "expect": "warn", "common": true,
      "bad":  { "app/utils.py": "" },
      "good": { "app/date_format.py": "" } },
    { "lang": "js", "rule": "7:name", "expect": "warn", "common": true, "name": "포괄 이름 폴더",
      "bad":  { "src/helpers/date.ts": "" },
      "good": { "src/date/format.ts": "" } },
    { "lang": "python", "rule": "7:type", "expect": "warn", "common": true,
      "bad":  { "app/services/order.py": "", "app/routers/order.py": "" },
      "good": { "app/orders/service.py": "", "app/orders/router.py": "" } },
    { "lang": "python", "rule": "7:depth", "expect": "warn", "common": true,
      "bad":  { "a/b/c/d/e/f/g/h/i/x.py": "" },
      "good": { "a/b/c/d/e/f/g/h/x.py": "" } }
  ]
}
