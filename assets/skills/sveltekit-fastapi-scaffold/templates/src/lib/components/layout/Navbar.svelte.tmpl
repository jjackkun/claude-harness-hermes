	import { auth } from '$stores/auth.svelte.js';

	function logout() {
		auth.logout();
		goto('/login');
	}
</script>

<header class="flex h-14 items-center justify-between border-b px-6">
	<span class="text-sm text-muted-foreground">{auth.user?.email ?? ''}</span>
	<div class="flex items-center gap-2">
		<button class="rounded-md p-2 hover:bg-accent" onclick={toggleMode} aria-label="테마 전환">
			<SunMoon class="size-4" />
		</button>
		<button class="flex items-center gap-1 rounded-md px-3 py-2 text-sm hover:bg-accent" onclick={logout}>
			<LogOut class="size-4" /> 로그아웃
		</button>
	</div>
</header>
