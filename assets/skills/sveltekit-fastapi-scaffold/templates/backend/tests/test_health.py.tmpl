async def test_liveness_is_not_wrapped(client):
    res = await client.get("/health")
    assert res.status_code == 200
    assert res.json() == {"status": "ok"}


async def test_api_health_is_wrapped_and_reaches_db(client):
    res = await client.get("/api/health")
    assert res.status_code == 200
    assert res.json() == {"ok": True, "status": 200, "data": {"status": "ok", "db": True}}
