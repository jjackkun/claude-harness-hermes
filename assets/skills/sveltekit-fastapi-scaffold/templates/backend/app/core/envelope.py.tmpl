"""Wrap every JSON /api response as {ok, status, data, error} with HTTP 200.

The frontend then checks `ok` instead of HTTP status codes. Binary and streaming
responses (downloads, exports) pass through untouched.
"""

import json
from typing import Any

from fastapi import Request
from fastapi.responses import JSONResponse
from starlette.middleware.base import BaseHTTPMiddleware
from starlette.responses import Response

DEFAULT_ERROR = "요청 처리에 실패했습니다."
DROP_HEADERS = ("content-length", "content-type")


def should_wrap(request: Request, response: Response) -> bool:
    is_api = request.url.path.startswith("/api/")
    is_json = response.headers.get("content-type", "").startswith("application/json")
    return is_api and is_json


def parse_body(body: bytes) -> Any:
    if not body:
        return None
    try:
        return json.loads(body)
    except json.JSONDecodeError:
        return body.decode(errors="replace")


def wrap(status: int, data: Any) -> dict[str, Any]:
    ok = 200 <= status < 300
    if ok:
        return {"ok": True, "status": status, "data": data}
    detail = data.get("detail") if isinstance(data, dict) else None
    if isinstance(detail, str):
        return {"ok": False, "status": status, "data": None, "error": detail}
    # validation errors: keep the field list as data
    return {"ok": False, "status": status, "data": detail, "error": DEFAULT_ERROR}


class EnvelopeMiddleware(BaseHTTPMiddleware):
    async def dispatch(self, request: Request, call_next):
        response = await call_next(request)
        if not should_wrap(request, response):
            return response
        body = b"".join([chunk async for chunk in response.body_iterator])
        headers = {k: v for k, v in response.headers.items() if k.lower() not in DROP_HEADERS}
        return JSONResponse(content=wrap(response.status_code, parse_body(body)), status_code=200, headers=headers)
