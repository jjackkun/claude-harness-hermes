# One .env for the whole project — read by vite, pm2 (ecosystem.config.cjs), scripts/*.mjs and the backend
# (backend/app/core/config.py). The scaffold writes the real .env with free ports and random secrets.
# Only keys starting with VITE_ can reach browser code — never give a secret a VITE_ name.
PROJECT_NAME={{PROJECT}}

VITE_FRONTEND_PORT_DEV=
VITE_FRONTEND_PORT_PROD=
API_PORT_DEV=
API_PORT_PROD=

# Project-local PostgreSQL (embedded-postgres, data in .pgdata/). The backend builds its URL from these.
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db   # optional: overrides the DB_* keys (e.g. production)

# Backend
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG_SQL=false
# ALLOWED_ORIGINS=https://example.com   # optional: defaults to http://localhost:<frontend ports>

# First superadmin — `corepack pnpm bootstrap` creates it once (skips if the email already exists).
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
