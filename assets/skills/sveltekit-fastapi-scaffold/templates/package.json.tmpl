{
	"name": "{{PROJECT}}",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"bootstrap": "node scripts/bootstrap.mjs",
		"migrate": "sh scripts/uv.sh --directory backend run alembic upgrade head",
		"test:backend": "sh scripts/uv.sh --directory backend run pytest",
		"create-user": "sh scripts/uv.sh --directory backend run python -m app.cli.create_user",
		"start:dev": "node scripts/pm2-start.cjs",
		"start:prod": "node scripts/pm2-start.cjs --prod",
		"restart:dev": "node scripts/pm2-start.cjs --restart",
		"restart:prod": "node scripts/pm2-start.cjs --prod --restart",
		"stop:dev": "pm2 stop {{PROJECT}}-dev",
		"stop:prod": "pm2 stop {{PROJECT}}-prod",
		"delete:dev": "pm2 delete {{PROJECT}}-dev",
		"delete:prod": "pm2 delete {{PROJECT}}-prod",
		"logs:dev": "pm2 logs --namespace {{PROJECT}}-dev --lines 50",
		"logs:prod": "pm2 logs --namespace {{PROJECT}}-prod --lines 50",
		"status": "pm2 status"
	},
	"devDependencies": {
		"@internationalized/date": "^3.10.1",
		"@lucide/svelte": "^0.561.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.18",
		"bits-ui": "^2.14.4",
		"clsx": "^2.1.1",
		"embedded-postgres": "18.6.0-beta.19",
		"mode-watcher": "^1.1.0",
		"pm2": "^6.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.4.0",
		"sass": "^1.97.1",
		"svelte": "^5.45.6",
		"svelte-sonner": "^1.0.7",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"vite": "^7.2.6"
	}
}
